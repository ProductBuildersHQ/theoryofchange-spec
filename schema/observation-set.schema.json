{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductBuildersHQ/impact-model/schema/v0/observation-set.schema.json",
  "$ref": "#/$defs/ObservationSet",
  "$defs": {
    "AssumptionAssessment": {
      "properties": {
        "assumptionId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "untested",
            "holding",
            "at_risk",
            "invalidated",
            "validated"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "assumptionId",
        "date",
        "status"
      ]
    },
    "LearningReview": {
      "properties": {
        "period": {
          "type": "string"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relatedIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "period"
      ]
    },
    "Note": {
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "text": {
          "type": "string"
        },
        "relatedIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "text"
      ]
    },
    "Observation": {
      "properties": {
        "indicatorId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "value": {
          "type": "number"
        },
        "level": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "type": "string"
        },
        "quality": {
          "type": "string",
          "enum": [
            "verified",
            "reported",
            "estimated"
          ]
        },
        "disaggregation": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "indicatorId",
        "date"
      ]
    },
    "ObservationSet": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ObservationSet"
          ]
        },
        "specVersion": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": "array"
        },
        "assumptionAssessments": {
          "items": {
            "$ref": "#/$defs/AssumptionAssessment"
          },
          "type": "array"
        },
        "stories": {
          "items": {
            "$ref": "#/$defs/Story"
          },
          "type": "array"
        },
        "learningReviews": {
          "items": {
            "$ref": "#/$defs/LearningReview"
          },
          "type": "array"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "specVersion",
        "modelId"
      ]
    },
    "Story": {
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "actorId": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "themeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outcomeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audienceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "consent": {
          "type": "string",
          "enum": [
            "granted",
            "not_granted",
            "unknown"
          ]
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "codedBy": {
          "type": "string"
        },
        "significance": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "date",
        "title",
        "summary",
        "consent",
        "sensitivity"
      ]
    }
  },
  "title": "Impact Model Observation Set",
  "description": "Indicator observations, assumption assessments, and notes for one impact model and period."
}
