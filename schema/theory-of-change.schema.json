{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductBuildersHQ/theoryofchange-spec/schema/v0/theory-of-change.schema.json",
  "$ref": "#/$defs/Document",
  "$defs": {
    "Actor": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "organization",
            "person",
            "group",
            "community",
            "customer_segment",
            "standards_body",
            "regulator",
            "vendor",
            "platform",
            "investor",
            "other"
          ]
        },
        "roles": {
          "items": {
            "type": "string",
            "enum": [
              "implementer",
              "beneficiary",
              "boundary_partner",
              "funder",
              "champion",
              "influencer",
              "competitor",
              "adopter",
              "gatekeeper"
            ]
          },
          "type": "array"
        },
        "stance": {
          "type": "string",
          "enum": [
            "champion",
            "supporter",
            "neutral",
            "skeptic",
            "opponent",
            "unknown"
          ]
        },
        "influence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "interest": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "description": {
          "type": "string"
        },
        "contact": {
          "$ref": "#/$defs/Person"
        },
        "externalRefs": {
          "items": {
            "$ref": "#/$defs/ExternalRef"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "Alignment": {
      "properties": {
        "elementId": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ExternalRef"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "elementId",
        "target"
      ]
    },
    "Approver": {
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approved": {
          "type": "boolean"
        },
        "comments": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Assumption": {
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "ifThenBecause": {
          "$ref": "#/$defs/IfThenBecause"
        },
        "type": {
          "type": "string",
          "enum": [
            "causal",
            "contextual",
            "implementation",
            "behavioral",
            "external",
            "partnership"
          ]
        },
        "appliesTo": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "criticality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "plausibility": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "explainsFully": {
          "type": "boolean"
        },
        "needsTesting": {
          "type": "boolean"
        },
        "test": {
          "type": "string"
        },
        "indicatorIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": [
            "untested",
            "holding",
            "at_risk",
            "invalidated",
            "validated"
          ]
        },
        "ownerActorId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "statement"
      ]
    },
    "Baseline": {
      "properties": {
        "value": {
          "type": "number"
        },
        "level": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CapabilityRef": {
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CausalLink": {
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "causes",
            "enables",
            "contributes_to",
            "necessary_condition"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "assumptionIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "interventionIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "polarity": {
          "type": "string",
          "enum": [
            "positive",
            "negative"
          ]
        },
        "feedback": {
          "type": "boolean"
        },
        "loopType": {
          "type": "string",
          "enum": [
            "reinforcing",
            "balancing"
          ]
        },
        "lag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "Ceiling": {
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "impact",
            "long_term",
            "intermediate",
            "short_term",
            "output"
          ]
        },
        "outcomeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Context": {
      "properties": {
        "problemStatement": {
          "type": "string"
        },
        "rootCauses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "targetPopulation": {
          "type": "string"
        },
        "market": {
          "$ref": "#/$defs/ExternalRef"
        },
        "geography": {
          "type": "string"
        },
        "timeHorizon": {
          "$ref": "#/$defs/TimeHorizon"
        },
        "narrative": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "problemStatement"
      ]
    },
    "Decision": {
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "ownerActorId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "decided",
            "deferred"
          ]
        },
        "relatedIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "question"
      ]
    },
    "Document": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "TheoryOfChange"
          ]
        },
        "specVersion": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "perspective": {
          "$ref": "#/$defs/Perspective"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "ceilingOfAccountability": {
          "$ref": "#/$defs/Ceiling"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/Outcome"
          },
          "type": "array",
          "minItems": 1
        },
        "preconditionGroups": {
          "items": {
            "$ref": "#/$defs/PreconditionGroup"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/CausalLink"
          },
          "type": "array"
        },
        "interventions": {
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "type": "array"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "type": "array"
        },
        "indicators": {
          "items": {
            "$ref": "#/$defs/Indicator"
          },
          "type": "array"
        },
        "actors": {
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "type": "array"
        },
        "actorRegistry": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "externalFactors": {
          "items": {
            "$ref": "#/$defs/ExternalFactor"
          },
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/Risk"
          },
          "type": "array"
        },
        "alignments": {
          "items": {
            "$ref": "#/$defs/Alignment"
          },
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "type": "array"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/Revision"
          },
          "type": "array"
        },
        "parent": {
          "type": "string",
          "pattern": "^toc:[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "pathways": {
          "items": {
            "$ref": "#/$defs/Pathway"
          },
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "type": "array"
        },
        "glossary": {
          "items": {
            "$ref": "#/$defs/GlossaryTerm"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "specVersion",
        "id",
        "context",
        "outcomes"
      ]
    },
    "Evidence": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "research",
            "evaluation",
            "monitoring_data",
            "expert_opinion",
            "stakeholder_testimony",
            "case_study",
            "internal_metric",
            "market_signal",
            "outcome_harvest",
            "anecdote"
          ]
        },
        "strength": {
          "type": "string",
          "enum": [
            "strong",
            "moderate",
            "weak",
            "anecdotal"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts"
          ]
        },
        "processTracingTest": {
          "type": "string",
          "enum": [
            "straw_in_the_wind",
            "hoop",
            "smoking_gun",
            "doubly_decisive"
          ]
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "accessedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title"
      ]
    },
    "ExternalFactor": {
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "enabler",
            "constraint",
            "trend",
            "shock"
          ]
        },
        "affects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "likelihood": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "trend": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "flat",
            "unknown"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "description"
      ]
    },
    "ExternalRef": {
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "okr",
            "bsc",
            "v2mom",
            "capability",
            "maturity_sli",
            "market_spec",
            "usm",
            "ufm",
            "sdg",
            "vsem",
            "visionstudio",
            "custom"
          ]
        },
        "ref": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "relation": {
          "type": "string",
          "enum": [
            "supports",
            "measures",
            "implements",
            "contributes_to",
            "same_as"
          ]
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "framework",
        "ref"
      ]
    },
    "GlossaryTerm": {
      "properties": {
        "id": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relatedIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "term",
        "definition"
      ]
    },
    "IfThenBecause": {
      "properties": {
        "if": {
          "type": "string"
        },
        "then": {
          "type": "string"
        },
        "because": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "if",
        "then"
      ]
    },
    "Indicator": {
      "properties": {
        "id": {
          "type": "string"
        },
        "measures": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "measurementType": {
          "type": "string",
          "enum": [
            "quantitative",
            "qualitative",
            "hybrid"
          ]
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "maintain"
          ]
        },
        "tolerance": {
          "type": "number"
        },
        "levels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "population": {
          "$ref": "#/$defs/Population"
        },
        "disaggregation": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dataSource": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "ownerActorId": {
          "type": "string"
        },
        "proxyFor": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "externalRefs": {
          "items": {
            "$ref": "#/$defs/ExternalRef"
          },
          "type": "array"
        },
        "metricId": {
          "type": "string"
        },
        "pathwayIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claim": {
          "type": "string",
          "enum": [
            "attribution",
            "contribution"
          ]
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rollupFrom": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "measures",
        "name"
      ]
    },
    "Intervention": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "program",
            "product",
            "policy",
            "advocacy",
            "partnership",
            "standardization",
            "investment",
            "communication",
            "research",
            "other"
          ]
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ownerActorId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "in_progress",
            "completed",
            "paused",
            "cancelled"
          ]
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityRef"
          },
          "type": "array"
        },
        "initiativeRefs": {
          "items": {
            "$ref": "#/$defs/ExternalRef"
          },
          "type": "array"
        },
        "resources": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "targets"
      ]
    },
    "Logic": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "all",
            "any",
            "at_least"
          ]
        },
        "k": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "Metadata": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "authors": {
          "items": {
            "$ref": "#/$defs/Person"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Metric": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "maintain"
          ]
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "sum",
            "mean",
            "weighted_mean",
            "min",
            "max",
            "latest",
            "none"
          ]
        },
        "weightMetricId": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "common",
            "pathway"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "definition",
        "formula"
      ]
    },
    "Outcome": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "impact",
            "long_term",
            "intermediate",
            "short_term",
            "output"
          ]
        },
        "sphere": {
          "type": "string",
          "enum": [
            "control",
            "influence",
            "interest"
          ]
        },
        "logic": {
          "$ref": "#/$defs/Logic"
        },
        "category": {
          "type": "string"
        },
        "changeType": {
          "type": "string",
          "enum": [
            "knowledge",
            "attitude",
            "skill",
            "behavior",
            "practice",
            "policy",
            "norm",
            "condition",
            "investment",
            "adoption"
