{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductBuildersHQ/impact-model/schema/v0/status-diff.schema.json",
  "$ref": "#/$defs/StatusDiff",
  "$defs": {
    "StatusChange": {
      "properties": {
        "elementId": {
          "type": "string"
        },
        "elementKind": {
          "type": "string",
          "enum": [
            "outcome",
            "preconditionGroup",
            "link",
            "intervention",
            "assumption",
            "indicator",
            "actor",
            "evidence",
            "externalFactor",
            "risk",
            "decision",
            "pathway",
            "metric",
            "term",
            "cause",
            "targetGroup",
            "audience",
            "theme",
            "criterion",
            "consultation"
          ]
        },
        "field": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "elementId",
        "elementKind",
        "field"
      ]
    },
    "StatusDiff": {
      "properties": {
        "modelId": {
          "type": "string"
        },
        "fromAsOf": {
          "type": "string",
          "format": "date"
        },
        "toAsOf": {
          "type": "string",
          "format": "date"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/StatusChange"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "modelId",
        "fromAsOf",
        "toAsOf"
      ]
    }
  },
  "title": "Impact Model Status Diff",
  "description": "Changes between two status snapshots."
}
